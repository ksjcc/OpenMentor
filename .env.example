# ============================================================================
# 把本文件复制成 .env（同目录）后填值即可，不要提交 .env 到仓库。
# Spring Boot 启动时会通过 application.yml 里的
#   spring.config.import: optional:file:./.env[.properties]
# 读取它；因此 .env 必须放在**启动时的工作目录**（在仓库根跑 mvnw 就是仓库根）。
#
# 也可以不用 .env，改成设置系统环境变量，效果一样。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 面试官本体（agentscope harness）—— 出题、追问、调用工具
#    默认 DeepSeek；换成任意 OpenAI 兼容端点只改这三项。
# ---------------------------------------------------------------------------
AGENTSCOPE_MODEL_API_KEY=
AGENTSCOPE_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENTSCOPE_MODEL_NAME=deepseek-chat
# 想用阿里云百炼（qwen）就这样填：
#   AGENTSCOPE_MODEL_API_KEY=<你的 dashscope key>
#   AGENTSCOPE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AGENTSCOPE_MODEL_NAME=qwen-plus

# ---------------------------------------------------------------------------
# 2. 简历解析 / 评分 / 知识提炼（langchain4j）
#    key 留空时会复用上面的 AGENTSCOPE_MODEL_API_KEY。
#    ★ base-url 和模型名必须和 key 属于同一家厂商，否则 401。
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=
AI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
# 同厂商替换示例：
#   智谱 GLM： https://open.bigmodel.cn/api/paas/v4   glm-4-flash
#   DeepSeek： https://api.deepseek.com/v1           deepseek-chat
#   Kimi：     https://api.moonshot.cn/v1            moonshot-v1-8k

# ---------------------------------------------------------------------------
# 3. RabbitMQ（可选，只有"面试后处理"需要：闪卡 / 画像合并 / 图谱索引）
#    本机没装 MQ 时把 LISTENER_ENABLED 设为 false，日志就不会每 5 秒刷连接失败。
# ---------------------------------------------------------------------------
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
# RABBITMQ_LISTENER_ENABLED=false

# ---------------------------------------------------------------------------
# 4. 其余都有默认值，需要覆盖时再打开（默认值见 application.yml）
# ---------------------------------------------------------------------------
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=career_mind
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=12345

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

# PGVECTOR_HOST=127.0.0.1
# PGVECTOR_PORT=5432
# PGVECTOR_DATABASE=career_vector
# PGVECTOR_USERNAME=postgres
# PGVECTOR_PASSWORD=12345
# PGVECTOR_TABLE=memory_vector
# PGVECTOR_MIN_SCORE=0.6
# 没有 pgvector 库时设为 false，跳过启动建表
# PGVECTOR_INITIALIZE_SCHEMA=false

# AI_EMBEDDING_MODEL=bge-m3
# AI_EMBEDDING_DIMENSIONS=1024
